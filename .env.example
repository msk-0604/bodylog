# BODYLOG environment variables
# Copy to `.env.local` and fill in. Never commit real values.
# EXPO_PUBLIC_* values are embedded into the app bundle and are visible to users.
# Only put values that are safe to be public here (Supabase anon/publishable key, RevenueCat public SDK keys).
# NEVER put the Supabase service_role key or any secret key in an EXPO_PUBLIC_* variable.

# Supabase (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# RevenueCat public SDK keys (Project > API keys) — Phase 6
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Server-only (Supabase Edge Functions secrets — set via `supabase secrets set`, NOT here in the app)
# REVENUECAT_WEBHOOK_AUTH=
