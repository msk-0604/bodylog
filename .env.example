# BODYLOG environment variables
# Copy to `.env.local` and fill in. Never commit real values.
# EXPO_PUBLIC_* values are embedded into the app bundle and are visible to users.
# Only put values that are safe to be public here (Supabase anon/publishable key, RevenueCat public SDK keys).
# NEVER put the Supabase service_role key or any secret key in an EXPO_PUBLIC_* variable.

# Supabase (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# RevenueCat PUBLIC SDK keys (Project > API keys): iOS starts with appl_, Android with goog_.
# Leave empty to build without billing (purchase screen shows 準備中). Secret keys (sk_…) are rejected.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Server-only (Supabase Edge Functions secrets — set via `supabase secrets set`, NOT here in the app):
# REVENUECAT_WEBHOOK_AUTH      Authorization header value for the webhook (32+ random characters)
# REVENUECAT_SECRET_API_KEY    RevenueCat secret API key (v1) used by subscription-sync / webhook
